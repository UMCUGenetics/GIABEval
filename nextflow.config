/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    UMCUGenetics/GIABEval Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'UMCUGenetics/GIABEval'
    author          = """UMCU Genetics"""
    homePage        = 'https://github.com/UMCUGenetics/GIABEval'
    description     = """UMCU Genetics Genome-in-a-bottle evaluation workflow for benchmarking"""
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.1'
    version         = '1.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-validation' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// Global default params, used in configs
params {
    // Input options
    vcf_path = null
    delim = "_"
    id_index = [0,3]

    // Perform pairwise comparison (true/false)
    run_pairwise = true

    // Run options
    genome_build = "GRCh38"
    nist_version = "hg002_nist_v4_2_1"

    // Output options
    publish_dir_mode = 'link'
    outdir = null


    // benchmarking references
    // TODO: include genome_stratifications

    // QC settings
    qc_settings_path = "${projectDir}/assets/checkqc_settings.yaml"
    multiqc_yaml     = "${projectDir}/assets/multiqc_config.yaml"

    // Institute specific slurm settings
    email = null
    cluster_options = "--mail-user $params.email --mail-type FAIL"
    cluster_account = "diaggen"
    singularity_cachedir = "/hpc/diaggen/software/singularity_cache/"
    singularity_runoptions = "-B /hpc:/hpc -B $TMPDIR:$TMPDIR"


}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Load reference genome config
includeConfig "conf/genomes_truthsets.config"
// Load base.config
includeConfig 'conf/base.config'
// Load modules.config for module specific options
includeConfig 'conf/modules.config'

profiles {
    // Use SLURM executor by default
    standard {
        process {
            executor       = "slurm"
            queue          = "cpu"
            clusterOptions = "$params.cluster_options"
            errorStrategy  = "retry"
            maxRetries     = 1
        }
        executor {
            queueSize         = 1000
            pollInterval      = '1min'
            queueStatInterval = '5min'
            submitRateLimit   = '10sec'
            account           = params.cluster_account
        }
        singularity.enabled    = true
        singularity.cacheDir   = params.singularity_cachedir
        singularity.runOptions = params.singularity_runoptions
        mail.smtp.host = 'localhost'
    }
}

report {
    enabled = true
    file = "$params.outdir/log/nextflow_report.html"
    overwrite = true
}

trace {
    enabled = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,vol_ctxt,inv_ctxt'
    file = "$params.outdir/log/nextflow_trace.txt"
    overwrite = true
}

timeline {
    enabled = true
    file = "$params.outdir/log/nextflow_timeline.html"
    overwrite = true
}
